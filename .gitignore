# APK files (large binary files)
*.apk

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment files (sensitive)
.env
.env.local
.env.*.local

# Screenshots and test artifacts (if large)
screenshots/*.xml